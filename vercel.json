{
  "cleanUrls": true,
  "routes": [
    { "src": "/services", "dest": "/services.html" },
    { "src": "/services/([^/]+)", "dest": "/_prerender/services/$1.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/offer", "dest": "/offer.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
